# development | staging | production
APP_ENV=development
PORT=10000
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-a-unique-48-byte-secret
JWT_ACCESS_EXPIRY_HOURS=24
JWT_REFRESH_EXPIRY_DAYS=30
# Comma-separated, exact browser origins. No wildcard in production.
# The public website needs its own exact origin for the availability form.
CORS_ORIGINS=https://whisperledger.in,https://www.whisperledger.in,https://admin.whisperledger.in
